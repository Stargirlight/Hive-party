# Local MongoDB
# MONGODB_URI=mongodb://localhost:27017/hive-party

# MongoDB Atlas (Cloud) - Recommended
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/hive-party?retryWrites=true&w=majority

PORT=3000

# Email Configuration (SMTP)
# For Gmail: Enable 2FA and create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password

# Session Configuration
# Generate a random secret key for production
SESSION_SECRET=change-this-to-a-random-secret-key-minimum-32-characters
